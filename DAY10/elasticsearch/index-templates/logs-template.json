{
  "index_patterns": [
    "logs-system-default",
    "logs-application-default",
    "logs-network-default",
    "logs-security-default"
  ],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "normalized_message": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 2048 } } },
        "event": {
          "properties": {
            "dataset": { "type": "keyword" },
            "original": { "type": "text" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "keyword" },
            "hostname": { "type": "keyword" }
          }
        },
        "service": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "log": {
          "properties": {
            "level": { "type": "keyword" },
            "file": { "properties": { "path": { "type": "keyword" } } }
          }
        },
        "source": {
          "properties": {
            "ip": { "type": "ip" }
          }
        },
        "destination": {
          "properties": {
            "ip": { "type": "ip" }
          }
        }
      }
    }
  }
}
